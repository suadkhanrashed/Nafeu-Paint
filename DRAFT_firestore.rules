rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Global Safety Net & Catch-all
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Shared Helpers (Eight Pillars Pattern) 
    // ===============================================================
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    
    // Master Admin Check (Safety Hatch & Identity Verification)
    function isMasterAdmin() { 
      return isSignedIn() && request.auth.token.email == "suadkhan.s1.qc@gmail.com"; 
    }
    
    // Identity & Path Hardening
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Profile Helpers (Avoid recursive reads in list operations)
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // RBAC Gates
    function isAdmin() { 
      return isMasterAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))); 
    }
    
    function hasRole(role) {
      return isAdmin() || (isSignedIn() && getUserRole() == role);
    }
    
    function isApproved() {
      return isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved');
    }

    // ===============================================================
    // Schema Validators (The Anti-Update-Gap)
    // ===============================================================
    
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'status', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.email == request.auth.token.email &&
             data.role is string &&
             data.status in ['pending', 'approved', 'suspended'] &&
             data.createdAt is string;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['shopCode', 'shopName', 'workerUid', 'workerName', 'items', 'grandTotal', 'status', 'createdAt', 'updatedAt']) &&
             data.workerUid == request.auth.uid &&
             data.status in ['pending', 'in_transport', 'delivered', 'cancelled', 'received', 'returned'] &&
             data.grandTotal is number && 
             data.grandTotal >= 0 &&
             data.items is list &&
             data.items.size() > 0 &&
             data.shopCode is string && data.shopCode.size() < 50;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['shopCode', 'amount', 'type', 'workerUid', 'workerName', 'date']) &&
             data.amount is number &&
             data.type in ['payment', 'due_addition', 'discount'] &&
             data.workerUid == request.auth.uid;
    }
    
    function isValidShop(data) {
      return data.keys().hasAll(['code', 'name', 'area', 'createdAt']) &&
             data.code is string && data.code.size() < 50 &&
             data.name is string && data.name.size() < 200 &&
             data.area is string && data.area.size() < 100;
    }

    // ===============================================================
    // Collection Matches
    // ===============================================================

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin() || hasRole('manager');
      allow create: if isVerified() && isValidUser(incoming());
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'assignedAreas', 'updatedAt']));
    }

    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if isMasterAdmin();
    }

    match /shops/{shopCode} {
      allow read: if isApproved();
      allow create: if isApproved() && (hasRole('admin') || hasRole('manager') || hasRole('worker')) && isValidShop(incoming());
      allow update: if isApproved() && (hasRole('admin') || hasRole('manager')) && isValidShop(incoming());
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isApproved();
      allow write: if isApproved() && (hasRole('admin') || hasRole('manager'));
    }

    match /orders/{orderId} {
      allow get: if isApproved() && (
        isAdmin() || hasRole('manager') || 
        existing().workerUid == request.auth.uid ||
        (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.shopCode == existing().shopCode)
      );
      allow list: if isApproved() && (
        isAdmin() || hasRole('manager') ||
        resource.data.workerUid == request.auth.uid ||
        (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.shopCode == resource.data.shopCode)
      );
      allow create: if isApproved() && hasRole('worker') && isValidOrder(incoming()) && exists(/databases/$(database)/documents/shops/$(incoming().shopCode));
      allow update: if isApproved() && (
        isAdmin() || 
        hasRole('manager') || 
        (hasRole('worker') && existing().workerUid == request.auth.uid && isValidOrder(incoming()) && (
          // Whitelisting status changes and item updates
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'items', 'grandTotal', 'dueAmount', 'updatedAt', 'modificationHistory'])
        )) ||
        (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.shopCode == existing().shopCode && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'modificationHistory']))
      );
      allow delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isApproved() && (
        isAdmin() || hasRole('manager') || 
        existing().workerUid == request.auth.uid ||
        (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.shopCode == existing().shopCode)
      );
      allow list: if isApproved() && (
        isAdmin() || hasRole('manager') ||
        resource.data.workerUid == request.auth.uid ||
        (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.shopCode == resource.data.shopCode)
      );
      allow create: if isApproved() && (hasRole('worker') || hasRole('manager') || isAdmin()) && isValidTransaction(incoming());
      allow update, delete: if isAdmin();
    }

    match /area_requests/{requestId} {
      allow read: if isApproved() && (isAdmin() || hasRole('manager') || existing().workerUid == request.auth.uid);
      allow create: if isApproved() && hasRole('worker');
      allow update: if isApproved() && (isAdmin() || hasRole('manager'));
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /activity/{activityId} {
      allow read: if isAdmin() || hasRole('manager');
      allow create: if isApproved();
    }
  }
}
