rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Global Safety Net & Catch-all
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Shared Helpers (Eight Pillars Pattern) 
    // ===============================================================
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    
    // Master Admin Check (Safety Hatch & Identity Verification)
    function isMasterAdmin() { 
      return isSignedIn() && (
        request.auth.uid == "NhlZjK6RjQMEREHmIIKVrUWoYYY2" ||
        (request.auth.token.get('email', '') == "suadkhan.s1.qc@gmail.com")
      ); 
    }
    
    // Identity & Path Hardening
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // RBAC Gates
    function isAdmin() { 
      return isMasterAdmin() || (isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'guest') in ['owner', 'admin'])
      )); 
    }
    
    function hasRole(role) {
      return isAdmin() || (isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'guest') == role
      );
    }
    
    function isApproved() {
      return isAdmin() || (isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'pending') == 'approved'
      );
    }

    // ===============================================================
    // Schema Validators (The Anti-Update-Gap)
    // ===============================================================
    
    function isValidUser(data, adminCreating) {
      return data.keys().hasAll(['uid', 'email', 'role', 'status', 'createdAt']) &&
             (adminCreating || data.uid == request.auth.uid) &&
             (data.email == request.auth.token.email || adminCreating || (request.auth.uid == "NhlZjK6RjQMEREHmIIKVrUWoYYY2" && data.email == "suadkhan.s1.qc@gmail.com")) &&
             data.role is string &&
             data.status in ['pending', 'approved', 'suspended'] &&
             data.createdAt is string;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['shopCode', 'workerUid', 'items', 'grandTotal', 'status']) &&
             data.workerUid is string &&
             data.status in ['pending', 'in_transport', 'delivered', 'cancelled', 'received', 'returned'] &&
             data.grandTotal is number && 
             data.items is list &&
             data.shopCode is string;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['shopCode', 'amount', 'type', 'workerUid', 'date']) &&
             data.amount is number &&
             data.type in ['payment', 'due_addition', 'discount', 'previous_order', 'previous_payment', 'previous_due'] &&
             data.workerUid is string;
    }
    
    function isValidShop(data) {
      return data.keys().hasAll(['code', 'name', 'area']) &&
             data.code is string &&
             data.name is string &&
             data.area is string;
    }

    function isValidOrderRequest(data) {
      return data.keys().hasAll(['shopCode', 'items', 'status']) &&
             data.status in ['pending', 'approved', 'rejected'] &&
             data.items is list &&
             data.shopCode is string;
    }

    // ===============================================================
    // Collection Matches
    // ===============================================================

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin() || hasRole('manager') || hasRole('worker');
      allow create: if (isAdmin() || isVerified() || request.auth.token.email == "suadkhan.s1.qc@gmail.com" || request.auth.uid == "NhlZjK6RjQMEREHmIIKVrUWoYYY2") && isValidUser(incoming(), isAdmin());
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'assignedAreas', 'updatedAt', 'shopCode', 'accentColor', 'phoneNumber']));
      allow delete: if isAdmin() || isMasterAdmin();
    }

    match /order_requests/{requestId} {
      allow read, list: if isApproved() && (
        isAdmin() || hasRole('manager') || hasRole('worker') ||
        (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         getUserData().shopCode == resource.data.shopCode)
      );
      allow create: if isApproved() && isValidOrderRequest(incoming());
      allow update: if isApproved() && (isAdmin() || hasRole('manager') || hasRole('worker'));
      allow delete: if isAdmin() || hasRole('manager') || isMasterAdmin();
    }

    match /role_permissions/{document=**} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin() || isMasterAdmin();
    }

    match /notifications/{notificationId} {
      allow read, list: if isSignedIn() && (
        isAdmin() || 
        resource.data.to == request.auth.uid || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         resource.data.to == getUserData().shopCode)
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isAdmin() || resource.data.to == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.to == request.auth.uid) || isMasterAdmin();
    }

    match /admins/{uid} {
      allow read, list: if isSignedIn();
      allow write: if isMasterAdmin();
    }

    match /shops/{shopCode} {
      allow read, list: if isApproved();
      allow create: if isApproved() && (isAdmin() || hasRole('manager') || hasRole('worker')) && isValidShop(incoming());
      allow update: if isApproved() && (isAdmin() || hasRole('manager') || hasRole('worker'));
      allow delete: if isAdmin() || isMasterAdmin();
    }

    match /products/{productId} {
      allow read, list: if isApproved();
      allow write: if isApproved() && (isAdmin() || hasRole('manager') || isMasterAdmin());
      allow delete: if isAdmin() || hasRole('manager') || isMasterAdmin();
    }

    match /orders/{orderId} {
      allow get: if isApproved() && (
        isAdmin() || hasRole('manager') || 
        existing().workerUid == request.auth.uid ||
        (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().shopCode == existing().shopCode)
      );
      allow list: if isApproved() && (
        isAdmin() || hasRole('manager') || hasRole('worker') ||
        (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().shopCode == resource.data.shopCode)
      );
      allow create: if isApproved() && (hasRole('worker') || hasRole('manager') || isAdmin()) && isValidOrder(incoming()) && incoming().workerUid == request.auth.uid;
      allow update: if isApproved() && (
        isAdmin() || 
        hasRole('manager') || 
        (hasRole('worker') && (existing().workerUid == request.auth.uid || existing().workerUid == null)) ||
        (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.shopCode == existing().shopCode && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'modificationHistory']))
      );
      allow delete: if isAdmin() || hasRole('manager') || isMasterAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isApproved() && (
        isAdmin() || hasRole('manager') || isMasterAdmin() ||
        existing().workerUid == request.auth.uid ||
        (isSignedIn() && getUserData().shopCode == existing().shopCode)
      );
      allow list: if isApproved() && (
        isAdmin() || hasRole('manager') || isMasterAdmin() ||
        (isSignedIn() && getUserData().shopCode == resource.data.shopCode)
      );
      allow create: if isApproved() && (hasRole('worker') || hasRole('manager') || isAdmin() || isMasterAdmin()) && isValidTransaction(incoming()) && (incoming().workerUid == request.auth.uid || isAdmin() || isMasterAdmin());
      allow update, delete: if isMasterAdmin() || (isApproved() && (isAdmin() || hasRole('manager') || (hasRole('worker') && existing().workerUid == request.auth.uid)));
    }

    match /area_requests/{requestId} {
      allow read, list: if isApproved() && (isAdmin() || hasRole('manager') || hasRole('worker'));
      allow create: if isApproved() && hasRole('worker');
      allow update: if isApproved() && (isAdmin() || hasRole('manager'));
      allow delete: if isAdmin() || isMasterAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || isMasterAdmin();
    }

    match /activity/{activityId} {
      allow read, list: if isAdmin() || hasRole('manager');
      allow create: if isApproved();
    }
  }
}
